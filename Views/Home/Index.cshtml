<!DOCTYPE html>
<html lang="hr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rezervacija Radnih Stolova</title>
    <!-- Bootstrap 5 CDN -->
    <link href="https://jsdelivr.net" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://jsdelivr.net" rel="stylesheet">
    <style>
            /* Prilagođeni stilovi za interaktivne stolove */
            .desk-card {
                transition: all 0.2s ease-in-out;
                cursor: pointer;
                border: 2px solid #dee2e6;
                min-height: 80px;
            }
            .desk-card:hover:not(.disabled) {
                transform: translateY(-3px);
                box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            }
            /* Stanja stolova */
            .desk-available { background-color: #f8f9fa; border-color: #198754; color: #198754; }
            .desk-available:hover { background-color: #e8f5e9; }

            .desk-occupied { background-color: #f8d7da; border-color: #dc3545; color: #dc3545; cursor: not-allowed; opacity: 0.7; }

            .desk-selected { background-color: #cff4fc; border-color: #0dcaf0; color: #0dcaf0; }
    </style>
</head>
<body class="bg-light">

    <div class="container py-5">
        <!-- Naslovna sekcija -->
        <div class="row mb-4 align-items-center">
            <div class="col">
                <h1 class="h3 mb-1"><i class="bi bi-building-fill text-primary me-2"></i>Rezervacija Stolova</h1>
                <p class="text-muted">Odaberite slobodno radno mjesto u uredu</p>
            </div>
        </div>

        <div class="row g-4">
            <!-- Lijeva strana: Filteri za pretragu -->
            <div class="col-lg-4">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <h5 class="card-title mb-3">Pretraži Dostupnost</h5>
                        <form>
                            <div class="mb-3">
                                <label class="form-label">Datum</label>
                                <input type="date" class="form-control" value="2026-08-29">
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Kat / Odjel</label>
                                <select class="form-select">
                                    <option>1. Kat - Razvoj softvera</option>
                                    <option>2. Kat - Marketing & Dizajn</option>
                                    <option>3. Kat - Uprava</option>
                                </select>
                            </div>
                            <button type="button" class="btn btn-primary w-100"><i class="bi bi-search me-2"></i>Osvježi Mapu</button>
                        </form>
                    </div>
                </div>

                <!-- Legenda stanja -->
                <div class="card shadow-sm border-0 mt-3">
                    <div class="card-body">
                        <h6 class="mb-3">Legenda</h6>
                        <div class="d-flex flex-column gap-2">
                            <div class="d-flex align-items-center"><span class="badge bg-light border border-success text-success p-2 me-2" style="width: 24px; height: 24px;"></span> Slobodno</div>
                            <div class="d-flex align-items-center"><span class="badge bg-danger-subtle border border-danger text-danger p-2 me-2" style="width: 24px; height: 24px;"></span> Zauzeto</div>
                            <div class="d-flex align-items-center"><span class="badge bg-info-subtle border border-info text-info p-2 me-2" style="width: 24px; height: 24px;"></span> Vaš odabir</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Desna strana: Interaktivni tlocrt / Mapa stolova -->
            <div class="col-lg-8">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Tlocrt Ureda</h5>
                        <span class="badge bg-secondary">Zona A</span>
                    </div>
                    <div class="card-body p-4">

                        <!-- Otok 1 (Desk Cluster 1) -->
                        <div class="mb-5 bg-white p-3 border rounded shadow-xs">
                            <h6 class="text-muted mb-3"><i class="bi bi-laptop me-2"></i>Radni Otok - Razvoj (Prozori)</h6>
                            <div class="row row-cols-2 row-cols-md-4 g-3">
                                <div class="col">
                                    <div class="card desk-card desk-available text-center p-3 h-100 d-flex flex-column justify-content-center" onclick="toggleDesk(this)">
                                        <i class="bi bi-display fs-4 mb-1"></i>
                                        <small class="fw-bold">Stol A-01</small>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="card desk-card desk-occupied text-center p-3 h-100 d-flex flex-column justify-content-center disabled">
                                        <i class="bi bi-display fs-4 mb-1"></i>
                                        <small class="fw-bold">Stol A-02</small>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="card desk-card desk-available text-center p-3 h-100 d-flex flex-column justify-content-center" onclick="toggleDesk(this)">
                                        <i class="bi bi-display fs-4 mb-1"></i>
                                        <small class="fw-bold">Stol A-03</small>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="card desk-card desk-selected text-center p-3 h-100 d-flex flex-column justify-content-center" onclick="toggleDesk(this)">
                                        <i class="bi bi-display fs-4 mb-1"></i>
                                        <small class="fw-bold">Stol A-04</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Otok 2 (Desk Cluster 2) -->
                        <div class="bg-white p-3 border rounded shadow-xs">
                            <h6 class="text-muted mb-3"><i class="bi bi-laptop me-2"></i>Radni Otok - Tiha Zona</h6>
                            <div class="row row-cols-2 row-cols-md-4 g-3">
                                <div class="col">
                                    <div class="card desk-card desk-occupied text-center p-3 h-100 d-flex flex-column justify-content-center disabled">
                                        <i class="bi bi-display fs-4 mb-1"></i>
                                        <small class="fw-bold">Stol B-01</small>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="card desk-card desk-available text-center p-3 h-100 d-flex flex-column justify-content-center" onclick="toggleDesk(this)">
                                        <i class="bi bi-display fs-4 mb-1"></i>
                                        <small class="fw-bold">Stol B-02</small>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="card desk-card desk-available text-center p-3 h-100 d-flex flex-column justify-content-center" onclick="toggleDesk(this)">
                                        <i class="bi bi-display fs-4 mb-1"></i>
                                        <small class="fw-bold">Stol B-03</small>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="card desk-card desk-occupied text-center p-3 h-100 d-flex flex-column justify-content-center disabled">
                                        <i class="bi bi-display fs-4 mb-1"></i>
                                        <small class="fw-bold">Stol B-04</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Akcijski gumb -->
                        <div class="mt-4 text-end">
                            <button class="btn btn-success btn-lg px-5 shadow-sm" type="submit">Potvrdi Rezervaciju</button>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Jednostavan JavaScript za odabir stola na klik -->
    <script>
            function toggleDesk(element) {
                // Preskoči ako je zauzeto
                if (element.classList.contains('desk-occupied')) return;

                // Logika za odabir i micanje odabira
                if (element.classList.contains('desk-selected')) {
                    element.classList.remove('desk-selected');
                    element.classList.add('desk-available');
                } else {
                    element.classList.remove('desk-available');
                    element.classList.add('desk-selected');
                }
            }
    </script>

    <script src="https://jsdelivr.net"></script>
</body>
</html>

