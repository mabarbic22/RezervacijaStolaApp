@model RezervacijaStolaApp.Models.Data.Reservation

@{
    ViewData["Title"] = "Obriši rezervaciju";
}

<h1>Obriši rezervaciju</h1>

<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ReservationDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ReservationDate)
        </dd>
    </dl>    
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.User)
        </dt>
        <dd class = "col-sm-10">
            <span>@Html.DisplayFor(model => model.User.Name)</span>
            <span>@Html.DisplayFor(model => model.User.Surname)</span>
        </dd>
    </dl>    
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Desk)
        </dt>
        <dd class = "col-sm-10">
            <span>Broj stola: @Html.DisplayFor(model => model.Desk.DeskNumber)</span>
        </dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Obriši" class="btn btn-danger" /> |
        <a asp-action="Index">Povratak</a>
    </form>
</div>
