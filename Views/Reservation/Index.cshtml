@model IEnumerable<RezervacijaStolaApp.Models.Data.Reservation>

@{
    ViewData["Title"] = "Lista rezervacija";
}

<h1>Lista rezervacija</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ReservationDate)
            </th>            
            <th>
                @Html.DisplayNameFor(model => model.User)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Desk)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
               <label>@(item.ReservationDate.ToShortDateString())</label>
            </td>
            <td>
                <label>@(item.User.Name + " " + item.User.Surname)</label>
            </td>
            <td>
                @Html.DisplayFor(model => item.Desk.DeskNumber)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Uredi</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Detalji</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Obriši</a>
            </td>
        </tr>
}
    </tbody>
</table>
